+/// Give ALSA enough capture headroom to tolerate ordinary scheduler jitter.
+/// `BufferSize::Default` selected two 241-frame periods on the commissioned
+/// PCS C-Media adapter: only about 10 ms at 48 kHz. A transient overrun then
+/// sends cpal into a POLLERR callback loop and forces a stream rebuild. This
+/// affects capture only; the persistent output stream keeps its small default
+/// buffer so GPIO-to-AFSK TX onset is not delayed.
+const INPUT_PERIOD_MS: u32 = 40;
+
+fn input_period_frames(sample_rate: u32) -> u32 {
+    sample_rate
+        .saturating_mul(INPUT_PERIOD_MS)
+        .checked_div(1000)
+        .unwrap_or(0)
+        .max(1)
+}
