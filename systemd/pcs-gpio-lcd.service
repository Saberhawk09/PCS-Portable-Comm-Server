[Unit]
Description=PCS HD44780 live status display
After=local-fs.target ModemManager.service gpsd.service pcs-gpio-startup.service
Wants=ModemManager.service gpsd.service pcs-gpio-startup.service

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=gpio
RuntimeDirectory=pcs-gpio-lcd
WorkingDirectory=/run/pcs-gpio-lcd
ExecStart=/usr/local/sbin/pcs-gpio lcd-status --hardware --apply
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
DevicePolicy=closed
DeviceAllow=/dev/gpiochip0 rw

[Install]
WantedBy=multi-user.target
