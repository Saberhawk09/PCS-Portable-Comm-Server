[Unit]
Description=PCS boot indicator self-test and bounded readiness grace
After=local-fs.target pcs-gpio-shutdown.service
Before=pcs-gpio-lcd.service pcs-gpio-leds.service pcs-gpio-stats.service
Wants=pcs-gpio-shutdown.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/pcs-gpio-startup
RemainAfterExit=yes
TimeoutStartSec=150
User=root
Group=root
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
DevicePolicy=closed
DeviceAllow=/dev/gpiochip0 rw
DeviceAllow=/dev/spidev0.0 rw
DeviceAllow=/dev/mem rw
DeviceAllow=/dev/gpiomem rw
DeviceAllow=/dev/vcio rw

[Install]
WantedBy=multi-user.target
