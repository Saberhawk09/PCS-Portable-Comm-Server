[Unit]
Description=PCS Dashboard Port 80 Redirect
After=network-online.target pcs-control-panel.service
Wants=network-online.target
Requires=pcs-control-panel.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Projects/PCS-Portable-Comm-Server
Environment=PCS_REDIRECT_HOST=0.0.0.0
Environment=PCS_REDIRECT_PORT=80
Environment=PCS_CONTROL_PORT=8080
ExecStart=/usr/bin/python3 /home/pi/Projects/PCS-Portable-Comm-Server/web/pcs-control-panel/pcs_dashboard_redirect.py
Restart=on-failure
RestartSec=3

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
