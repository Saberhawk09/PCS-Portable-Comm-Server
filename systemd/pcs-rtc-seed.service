[Unit]
Description=Seed PCS system clock from hardware RTC
Documentation=file:/home/pi/Projects/PCS-Portable-Comm-Server/docs/time-sources.md
After=local-fs.target fake-hwclock.service dev-rtc0.device
Wants=dev-rtc0.device
Before=chrony.service systemd-timesyncd.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/pcs-rtc-seed
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
