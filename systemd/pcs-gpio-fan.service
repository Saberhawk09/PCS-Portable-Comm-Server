[Unit]
Description=PCS GPIO18 hardware PWM thermal fan controller
After=local-fs.target
ConditionPathExists=/sys/class/pwm/pwmchip0

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/sbin/pcs-gpio fan-control --hardware --apply
ExecStopPost=-/usr/local/sbin/pcs-gpio fan-failsafe --hardware --apply
Restart=on-failure
RestartSec=2
RuntimeDirectory=pcs-gpio-fan
RuntimeDirectoryMode=0755
WorkingDirectory=/run/pcs-gpio-fan
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
DevicePolicy=closed

[Install]
WantedBy=multi-user.target
