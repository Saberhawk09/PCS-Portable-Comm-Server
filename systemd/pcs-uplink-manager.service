[Unit]
Description=PCS WAN health, automatic uplink selection and boot usage
After=NetworkManager.service
Wants=NetworkManager.service
Conflicts=pcs-cellular-fallback.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/sbin/pcs-uplink-manager
Restart=on-failure
RestartSec=5
RuntimeDirectory=pcs-uplink-manager
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# Only per-WAN reverse-path filtering is adjusted for bound standby probes.
ProtectKernelTunables=no
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/run/pcs-uplink-manager /run/lock
ReadWritePaths=/proc/sys/net/ipv4/conf
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
LockPersonality=yes

[Install]
WantedBy=multi-user.target
