[Unit]
Description=PCS six-pixel WS2812 health indicators
After=local-fs.target ModemManager.service gpsd.service
Wants=ModemManager.service gpsd.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/opt/pcs-gpio-leds/bin/python /usr/local/sbin/pcs-gpio led-status --hardware --apply
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
DevicePolicy=closed
DeviceAllow=/dev/mem rw
DeviceAllow=/dev/gpiomem rw
DeviceAllow=/dev/vcio rw

[Install]
WantedBy=multi-user.target
