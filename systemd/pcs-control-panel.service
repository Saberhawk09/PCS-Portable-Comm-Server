[Unit]
Description=PCS Control Panel Web Interface
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Projects/PCS-Portable-Comm-Server
Environment=PCS_CONTROL_HOST=0.0.0.0
Environment=PCS_CONTROL_PORT=8080
ExecStart=/usr/bin/python3 /home/pi/Projects/PCS-Portable-Comm-Server/web/pcs-control-panel/pcs_control_panel.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
