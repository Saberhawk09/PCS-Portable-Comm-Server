[Unit]
Description=PCS Local Web Backend and Administrative Control Panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Projects/PCS-Portable-Comm-Server
Environment=PCS_CONTROL_HOST=127.0.0.1
Environment=PCS_CONTROL_PORT=8081
Environment=PCS_CONTROL_TRUST_PROXY=1
Environment=PCS_ADMIN_CREDENTIAL_FILE=/etc/pcs-control-panel/admin.json
Environment=PCS_SESSION_KEY_FILE=/etc/pcs-control-panel/session.key
ExecStart=/usr/bin/python3 /home/pi/Projects/PCS-Portable-Comm-Server/web/pcs-control-panel/pcs_control_panel.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
