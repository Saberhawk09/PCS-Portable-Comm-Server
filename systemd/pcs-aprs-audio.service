[Unit]
Description=Restore and verify PCS APRS USB audio levels
After=sound.target alsa-restore.service
Wants=sound.target
Before=direwolf.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=direwolf
Group=direwolf
SupplementaryGroups=audio
Environment=PCS_APRS_AUDIO_CONFIG=/etc/pcs/aprs/audio.conf
ExecStart=/usr/local/sbin/pcs-aprs-audio --apply --wait-seconds 60
RemainAfterExit=yes
Restart=on-failure
RestartSec=5s
TimeoutStartSec=75s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
