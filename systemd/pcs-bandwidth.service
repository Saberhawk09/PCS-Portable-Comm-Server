[Unit]
Description=PCS per-client WAN bandwidth manager
Wants=network-online.target
After=network-online.target NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/pcs-bandwidth daemon
ExecReload=/usr/local/sbin/pcs-bandwidth reload
ExecStopPost=/usr/local/sbin/pcs-bandwidth stop
Restart=on-failure
RestartSec=10
TimeoutStopSec=90
RuntimeDirectory=pcs-bandwidth
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/etc/pcs /run/pcs-bandwidth
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
