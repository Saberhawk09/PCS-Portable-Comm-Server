[Unit]
Description=PCS priority-arbitrated audible status
After=local-fs.target pcs-power-monitor.service

[Service]
Type=simple
User=root
Group=gpio
RuntimeDirectory=pcs-buzzer
RuntimeDirectoryMode=0775
ExecStart=/usr/local/sbin/pcs-buzzer service
ExecStopPost=/usr/local/sbin/pcs-buzzer request silent --seconds 1
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
DevicePolicy=closed
DeviceAllow=/dev/gpiochip0 rw

[Install]
WantedBy=multi-user.target
